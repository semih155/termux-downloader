col_add_interactive() {
    echo
    echo "TikTok'ta: Profil > Kaydedilenler (yer imi) > klasörü aç > Paylaş > Bağlantıyı kopyala"
    local in url id name
    read -r -p "Klasör linki: " in
    url=$(extract_url "$in")
    if ! echo "$url" | grep -Eq 'tiktok\.com/@[^/]+/collection/'; then
        echo "❌ Bu bir TikTok klasör (collection) linki gibi görünmüyor."; return
    fi
    id=$(col_id_from_url "$url")
    name=$(col_name_from_url "$url")
    read -r -p "Klasör adı [$name]: " in
    [ -n "$in" ] && name="$in"
    choose_type 1
    col_save "$id" "$name" "$url" "$CHOSEN_TYPE"
    echo "✅ Eklendi: $name  [$(type_label "$CHOSEN_TYPE")]"
}

menu_collections() {
    while true; do
        echo
        echo "── TikTok kayıtlı klasörlerim ──"
        local n=0 id name url ctype
        if [ -s "$COL_FILE" ]; then
            while IFS='|' read -r id name url ctype; do
                n=$((n+1)); printf '  %d) %s  [%s]\n' "$n" "$name" "$(type_label "$ctype")"
            done < "$COL_FILE"
        else
            echo "  (henüz klasör eklenmemiş)"
        fi
        echo "  a) Klasör ekle"
        echo "  0) Geri"
        read -r -p "Seçim: " s
        case "$s" in
            0|"") return ;;
            a|A) col_add_interactive ;;
            *)
                if [[ "$s" =~ ^[0-9]+$ ]] && [ "$s" -ge 1 ] && [ "$s" -le "$n" ]; then
                    col_actions "$(sed -n "${s}p" "$COL_FILE")"
                fi ;;
        esac
    done
}

menu_tiktok_login() {
    while true; do
        echo
        echo "── TikTok hesabı ──"
        if [ -f "$TIKTOK_COOKIES" ]; then echo "Durum: ✅ giriş bilgisi kayıtlı"; else echo "Durum: ❌ giriş yok"; fi
        echo "  1) sessionid yapıştır (giriş yap)"
        echo "  2) cookies.txt dosyasından al (dosya yolu)"
        echo "  3) Çıkış yap (kayıtlı bilgiyi sil)"
        echo "  4) sessionid nasıl bulunur?"
        echo "  0) Geri"
        read -r -p "Seçim: " s
        case "$s" in
            1)
                read -r -p "sessionid: " sid
                sid=$(printf '%s' "$sid" | tr -d ' "'"'"'\r\n')
                if [[ "$sid" =~ ^[A-Za-z0-9%_-]{20,}$ ]]; then
                    local exp=$(( $(date +%s) + 31536000 ))
                    {
                        printf '# Netscape HTTP Cookie File\n'
                        printf '.tiktok.com\tTRUE\t/\tTRUE\t%s\tsessionid\t%s\n' "$exp" "$sid"
                        printf '.tiktok.com\tTRUE\t/\tTRUE\t%s\tsessionid_ss\t%s\n' "$exp" "$sid"
                    } > "$TIKTOK_COOKIES"
                    chmod 600 "$TIKTOK_COOKIES"
                    echo "✅ Kaydedildi."
                else
                    echo "❌ Geçersiz görünüyor (en az 20 harf/rakam olmalı)."
                fi ;;
            2)
                read -r -p "cookies.txt yolu: " f
                f="${f/#\~/$HOME}"
                if [ -f "$f" ]; then cp "$f" "$TIKTOK_COOKIES" && chmod 600 "$TIKTOK_COOKIES" && echo "✅ Kaydedildi."; else echo "❌ Dosya bulunamadı."; fi ;;
            3) rm -f "$TIKTOK_COOKIES"; echo "✅ Silindi." ;;
            4)
                echo
                echo "1) Telefonda/bilgisayarda tarayıcıdan tiktok.com'a gir ve hesabına giriş yap."
                echo "2) Bilgisayar Chrome: F12 > Application > Cookies > https://www.tiktok.com"
                echo "   listesinden 'sessionid' satırının Value değerini kopyala."
                echo "   (Telefonda: Kiwi Browser ya da 'Cookie Editor' eklentisiyle aynısı.)"
                echo "3) Yukarıdaki 1. seçenekle buraya yapıştır."
                echo "⚠️  sessionid, hesabına giriş anahtarıdır. Kimseyle paylaşma."
                echo "   Şifreni bu script hiçbir zaman istemez." ;;
            0|"") return ;;
        esac
    done
}

