        echo "  2) Eski videolardan yeniye doğru"
        read -r -p "Seçim (1-2): " sira
        if [[ "$adet" =~ ^[0-9]+$ ]] && [ "$adet" -gt 0 ]; then LIST_ARGS+=(--playlist-end "$adet"); fi
        [ "$sira" = "2" ] && LIST_ARGS+=(--playlist-reverse)
        arch="$V_ARCH"; [ "$type" = "audio" ] && arch="$A_ARCH"
        if [ "$sira" != "2" ] && [ -s "$arch" ]; then
            read -r -p "Sadece yeni videolar indirilsin mi? (daha önce indirilene gelince dur) (e/H): " only_new
            case "$only_new" in e|E|evet) LIST_ARGS+=(--break-on-existing) ;; esac
        fi
    fi
    notify "TikTok profili toplu indiriliyor..."
    fetch "$url" "$type" \
        "$DOWNLOAD_DIR/TikTok/%(uploader)s/%(upload_date)s - %(title).60s.%(ext)s" \
        "$MUSIC_DIR/TikTok/%(uploader)s/%(upload_date)s - %(title).60s.%(ext)s"
    rc=$?
    V_ARCH=""; A_ARCH=""
    finish_job "$rc" "$url" "$type" "TikTok profili"
}

# ---------------------------------------------------------------- ana is akisi
process_url() {  # URL TUR
    local url="$1" type="$2" rc=0 SITE
    EXTRA_ARGS=(); LIST_ARGS=(); V_ARCH=""; A_ARCH=""
    JOB_MARK="$HOME/.termux-downloader-mark"; touch -d '3 seconds ago' "$JOB_MARK" 2>/dev/null || touch "$JOB_MARK"
    if echo "$url" | grep -Eq 'tiktok\.com/@[^/]+/collection/'; then
        job_collection "$url" "$type"; return $?
    elif echo "$url" | grep -Eq 'tiktok\.com/@[^/]+/?($|\?)'; then
        job_profile "$url" "$type"; return $?
    elif echo "$url" | grep -Eq 'tiktok\.com'; then
        echo ">> TikTok - en yüksek kalitede indiriliyor... [$(type_label "$type")]"
        notify "TikTok indiriliyor..."
        use_cookies tiktok
        FORMAT="best/bestvideo+bestaudio"
        fetch "$url" "$type" "$DOWNLOAD_DIR/TikTok/%(title).80s.%(ext)s" "$MUSIC_DIR/TikTok/%(title).80s.%(ext)s"; rc=$?
        finish_job "$rc" "$url" "$type" "TikTok"
    elif echo "$url" | grep -Eq 'facebook\.com|fb\.watch'; then
        echo ">> Facebook - en yüksek kalitede indiriliyor... [$(type_label "$type")]"
        notify "Facebook indiriliyor..."
        use_cookies facebook
        FORMAT="$(vfmt "")"
        fetch "$url" "$type" "$DOWNLOAD_DIR/Facebook/%(title).80s.%(ext)s" "$MUSIC_DIR/Facebook/%(title).80s.%(ext)s"; rc=$?
        finish_job "$rc" "$url" "$type" "Facebook"
    elif echo "$url" | grep -Eq 'twitter\.com|x\.com'; then
        echo ">> Twitter/X [$(type_label "$type")]"
        notify "Twitter/X indiriliyor..."
        use_cookies twitter
        FORMAT="$(vfmt "")"
        [ "$type" != "audio" ] && get_format_for_url "$url"
        fetch "$url" "$type" "$DOWNLOAD_DIR/Twitter/%(uploader)s - %(title).60s.%(ext)s" "$MUSIC_DIR/Twitter/%(uploader)s - %(title).60s.%(ext)s"; rc=$?
        finish_job "$rc" "$url" "$type" "Twitter/X"
    elif echo "$url" | grep -Eq 'youtube\.com|youtu\.be'; then
        echo ">> YouTube [$(type_label "$type")]"
        FORMAT="$(default_fmt)"
        if [ "$type" != "audio" ] && [ "$INTERACTIVE" = 1 ]; then quality_menu; fi
        [ "$FORMAT" = "AUDIO_ONLY" ] && type=audio
        notify "YouTube indiriliyor..."
        use_cookies youtube
        EXTRA_ARGS+=(-4)
        fetch "$url" "$type" "$DOWNLOAD_DIR/YouTube/%(title).80s.%(ext)s" "$MUSIC_DIR/YouTube/%(title).80s.%(ext)s"; rc=$?
        finish_job "$rc" "$url" "$type" "YouTube"
    else
        echo ">> Genel site [$(type_label "$type")]"
        notify "Video indiriliyor..."
        SITE=$(echo "$url" | sed -E 's~^https?://(www\.)?([^/?#]+).*~\2~')
        use_cookies "$SITE"
        FORMAT="$(vfmt "")"
        [ "$type" != "audio" ] && get_format_for_url "$url"
        [ "$FORMAT" = "AUDIO_ONLY" ] && type=audio
        fetch "$url" "$type" "$DOWNLOAD_DIR/$SITE/%(title).80s.%(ext)s" "$MUSIC_DIR/$SITE/%(title).80s.%(ext)s"; rc=$?
        finish_job "$rc" "$url" "$type" "İndirme"
    fi
    return $?
}

extract_url() {
    local u
    u=$(printf '%s\n' "$1" | grep -oE 'https?://[^[:space:]]+' | head -1)
    [ -z "$u" ] && u="$1"
    printf '%s' "$u"
}

# ---------------------------------------------------------------- guncelleme
install_copies() {  # calisan scripti hem ~/bin (Paylas menusu) hem ~/.shortcuts icine koy
    local d
    mkdir -p "$HOME/bin" "$HOME/.shortcuts"
    for d in "$HOME/bin/termux-url-opener" "$HOME/.shortcuts/termux-url-opener"; do
        if [ "$(readlink -f "$d" 2>/dev/null)" != "$SELF" ]; then
            cp "$SELF" "$d.tmp" && mv "$d.tmp" "$d" && chmod +x "$d"
        fi
    done
    ln -sf "$HOME/bin/termux-url-opener" "$HOME/bin/indir"
    [ -n "$PREFIX" ] && ln -sf "$HOME/bin/termux-url-opener" "$PREFIX/bin/indir"
}

check_update() {  # $1=force
    command -v curl >/dev/null 2>&1 || return 0
    local LAST_CHECK_FILE="$HOME/.termux-downloader-lastcheck" NOW LAST_CHECK REMOTE_VERSION LOCAL_VERSION
    NOW=$(date +%s)
    LAST_CHECK=$(cat "$LAST_CHECK_FILE" 2>/dev/null || echo 0)
    if [ "$1" != "force" ] && [ $((NOW - LAST_CHECK)) -lt 86400 ]; then return 0; fi
    echo "$NOW" > "$LAST_CHECK_FILE"
    REMOTE_VERSION=$(curl -sL --max-time 4 "$RAW/VERSION" 2>/dev/null || echo "")
    [ -z "$REMOTE_VERSION" ] && return 0
    LOCAL_VERSION=$(cat "$VERSION_FILE" 2>/dev/null || echo "0")
    if [ "$REMOTE_VERSION" != "$LOCAL_VERSION" ]; then
        echo "🔄 Güncelleme bulundu ($LOCAL_VERSION -> $REMOTE_VERSION)..."
        if curl -sL --max-time 30 "$RAW/termux-url-opener" -o "$SELF.tmp" && head -1 "$SELF.tmp" | grep -q '^#!'; then
            mv "$SELF.tmp" "$SELF"; chmod +x "$SELF"
            echo "$REMOTE_VERSION" > "$VERSION_FILE"
            SELF="$SELF" install_copies
            echo "✅ Güncellendi, yeniden başlatılıyor..."
            exec bash "$SELF" ${RAW_INPUT:+"$RAW_INPUT"}
        else
            rm -f "$SELF.tmp"
        fi
    fi
}

