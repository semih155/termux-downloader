            2) read -r -p "Kaç kez denensin? (1-10): " v
               if [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 10 ]; then cfg_set RETRIES "$v"; else echo "Geçersiz."; fi ;;
            3) if [ "$WIFI_ONLY" = 1 ]; then cfg_set WIFI_ONLY 0; else cfg_set WIFI_ONLY 1; fi ;;
