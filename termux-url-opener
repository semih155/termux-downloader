# Varsayilan kalitenin format karsiligi
default_fmt() {
    case "$DEFAULT_QUALITY" in 480|720|1080) vfmt "$DEFAULT_QUALITY" ;; best) vfmt "" ;; *) vfmt 360 ;; esac
}

# Uyumlu (H.264 + AAC) format secici. $1 = en fazla yukseklik (bos = sinirsiz)
vfmt() {
    local h=""
    [ -n "$1" ] && h="[height<=$1]"
    if [ "$COMPAT_MODE" = 1 ]; then
        echo "bestvideo[vcodec^=avc1]${h}+bestaudio[acodec^=mp4a]/best[ext=mp4]${h}/bestvideo${h}+bestaudio/best${h}"
    else
        echo "bestvideo${h}+bestaudio/best${h}"
    fi
}

# Indirilen videolari kontrol et; H.264/AAC/yuv420p mp4 degilse cevir. $1 = isaret dosyasi (bu islemden sonra olusanlar)
fix_compat() {
    [ "$COMPAT_MODE" = 1 ] || return 0
    command -v ffprobe >/dev/null 2>&1 && command -v ffmpeg >/dev/null 2>&1 || return 0
    [ -f "$1" ] || return 0
    local f vc ac pf out final ext
    local vopts aopts
    while IFS= read -r -d '' f; do
        vc=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$f" 2>/dev/null | head -1)
        [ -z "$vc" ] && continue
        ac=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$f" 2>/dev/null | head -1)
        pf=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of csv=p=0 "$f" 2>/dev/null | head -1)
        ext="${f##*.}"; ext="${ext,,}"
        if [ "$vc" = h264 ] && { [ -z "$ac" ] || [ "$ac" = aac ]; } && [ "$pf" = yuv420p ] && [[ "$ext" =~ ^(mp4|m4v|mov)$ ]]; then
            continue
        fi
        echo "🎞️  Her telefonda oynaması için çevriliyor: $(basename "$f")  [$vc/${ac:-ses yok}]"
        out="${f%.*}.compat.mp4"
        vopts=(-c:v copy)
        if [ "$vc" != h264 ] || [ "$pf" != yuv420p ]; then
            vopts=(-c:v libx264 -preset veryfast -crf 22 -pix_fmt yuv420p -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2")
        fi
        aopts=(-c:a copy)
        if [ -n "$ac" ] && [ "$ac" != aac ]; then aopts=(-c:a aac -b:a 192k); fi
        if ffmpeg -nostdin -v error -stats -y -i "$f" -map 0:v:0 -map '0:a:0?' -map_metadata 0 \
                "${vopts[@]}" "${aopts[@]}" -movflags +faststart "$out" </dev/null; then
            final="${f%.*}.mp4"
            mv -f "$out" "$final"
            [ "$f" != "$final" ] && rm -f "$f"
            echo "   ✅ Tamam"
        else
            rm -f "$out"
            echo "   ⚠️  Çevrilemedi, dosya olduğu gibi bırakıldı."
        fi
    done < <(find "$DOWNLOAD_DIR" -type f -newer "$1" \( -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.webm' -o -iname '*.mov' -o -iname '*.m4v' \) \
                 -not -name '*.compat.mp4' -not -path "$MUSIC_DIR/*" -print0 2>/dev/null)
}

# ---------------------------------------------------------------- yt-dlp + tekrar deneme
build_common() {
    COMMON=(--no-warnings --newline --progress-template "$PT"
        --continue --concurrent-fragments "$PARALLEL"
        --retries 20 --fragment-retries 20
        --retry-sleep http:exp=1:20 --retry-sleep fragment:exp=1:20
        --socket-timeout 20
        --embed-metadata --no-mtime
        --parse-metadata "${ARTIST}%(x|)s:%(artist)s"
        --parse-metadata "${ARTIST}%(x|)s:%(album_artist)s")
    if command -v node >/dev/null 2>&1; then
        if [ -z "$YT_JS_OK" ]; then
            if yt-dlp --help 2>/dev/null | grep -q -- '--js-runtimes'; then YT_JS_OK=1; else YT_JS_OK=0; fi
        fi
        [ "$YT_JS_OK" = 1 ] && COMMON+=(--js-runtimes node)
    fi
    if [ "$ARIA2" = 1 ] && command -v aria2c >/dev/null 2>&1; then
        COMMON+=(--downloader aria2c --downloader "dash,m3u8:native")
    fi
    AUDIO_ARGS=(-x --audio-format mp3 --audio-quality 0 --embed-thumbnail --convert-thumbnails jpg)
}

