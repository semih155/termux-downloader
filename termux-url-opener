cookie_import() {  # $1 = anahtar
    local key="$1" f
    mkdir -p "$COOKIE_DIR"
    echo "Tarayıcıdan dışa aktardığın cookies.txt dosyasının yolu"
    echo "(örnek: ~/storage/downloads/cookies.txt)"
    read -r -p "Yol: " f
    f="${f/#\~/$HOME}"
    if [ ! -f "$f" ]; then echo "❌ Dosya bulunamadı."; return; fi
    if ! grep -q "$(printf '\t')" "$f"; then echo "❌ Bu bir cookies.txt (Netscape) dosyası gibi görünmüyor."; return; fi
    cp "$f" "$COOKIE_DIR/$key.txt" && chmod 600 "$COOKIE_DIR/$key.txt" && echo "✅ $key için çerez kaydedildi."
}

menu_cookies() {
    local s h f
    while true; do
        echo
        echo "── Site çerezleri ──"
        if ls "$COOKIE_DIR"/*.txt >/dev/null 2>&1; then
            for f in "$COOKIE_DIR"/*.txt; do echo "  ✅ $(basename "$f" .txt)"; done
        else
            echo "  (henüz çerez yok)"
        fi
        echo "  1) YouTube"
        echo "  2) X (Twitter)"
        echo "  3) Facebook"
        echo "  4) Başka site (alan adı yaz)"
        echo "  5) Çerez sil"
        echo "  6) Çerez nasıl alınır?"
        echo "  0) Geri"
        read -r -p "Seçim: " s
        case "$s" in
            1) cookie_import youtube ;;
            2) cookie_import twitter ;;
            3) cookie_import facebook ;;
            4) read -r -p "Site (örn: instagram.com): " h
               h=$(printf '%s' "$h" | tr 'A-Z' 'a-z' | sed -E 's~^https?://~~; s~^www\.~~; s~[/?#].*~~' | tr -cd 'a-z0-9.-')
               [ -n "$h" ] && cookie_import "$h" ;;
            5) read -r -p "Hangisi silinsin? (ör: youtube): " h
               h=$(printf '%s' "$h" | tr -cd 'A-Za-z0-9.-')
               [ -n "$h" ] && rm -f "$COOKIE_DIR/$h.txt" && echo "✅ Silindi (varsa)." ;;
            6)
                echo
                echo "1) Tarayıcıda 'Get cookies.txt LOCALLY' eklentisini kur"
                echo "   (telefonda Kiwi Browser, ya da bilgisayarda Chrome)."
                echo "2) Siteye giriş yap, eklentiden 'Export' de, dosyayı İndirilenler'e kaydet."
                echo "3) Buradan dosyanın yolunu yaz."
