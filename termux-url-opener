                echo "   YouTube için ana hesabını DEĞİL, yedek bir Google hesabı kullan"
                echo "   (otomatik indirmede hesap kısıtlanabilir)." ;;
            0|"") return ;;
        esac
    done
}

retry_failed() {
    if [ ! -s "$FAILED_FILE" ]; then echo "Başarısız indirme yok. 👍"; return; fi
    local tmp="$FAILED_FILE.run" line type url
    mv "$FAILED_FILE" "$tmp"
    INTERACTIVE=0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        type="${line%%|*}"; url="${line#*|}"
        echo; echo "🔁 $url"
        process_url "$url" "$type"
    done < "$tmp"
    rm -f "$tmp"
    INTERACTIVE=1
}

