}

# Donus kodlari: 0 tamam | 2 Wi-Fi yok/vazgecildi | 4 URL desteklenmiyor | 5 giris gerekiyor | diger: yt-dlp hata kodu
ytdlp_retry() {
    local attempt=1 rc=1 w drops=0
    build_common
    while [ "$attempt" -le "$RETRIES" ]; do
        wifi_gate || return 2
        wait_for_internet
        [ "$attempt" -gt 1 ] && echo "🔁 Yeniden deneniyor ($attempt/$RETRIES)..."
        yt-dlp "${COMMON[@]}" "${EXTRA_ARGS[@]}" "$@" 2>&1 | tee "$LOGF"
        rc=${PIPESTATUS[0]}
        [ "$rc" -eq 0 ] && return 0
        if grep -qi 'Unsupported URL' "$LOGF"; then return 4; fi
        if grep -Eqi 'log ?in|logged in|sign in|private video|sessionid' "$LOGF"; then
            login_hint
            return 5
        fi
        if ! has_internet; then
            drops=$((drops + 1))
            if [ "$drops" -le 30 ]; then
                echo "📡 Bağlantı koptu. Gelince kaldığı yerden devam edilecek (kısmi dosya korunuyor)..."
                wait_for_internet 3600
                continue
            fi
        fi
        [ "$attempt" -ge "$RETRIES" ] && break
        if [ "$attempt" -eq 2 ] && [ "$AUTO_YTDLP_UPDATE" = 1 ] && [ "$YTDLP_UPDATED" = 0 ]; then
            update_ytdlp
        fi
        w=$((3 * (1 << (attempt - 1)))); [ "$w" -gt 30 ] && w=30
        echo "⚠️  Hata (kod $rc). $w sn sonra tekrar denenecek..."
        sleep "$w"
        attempt=$((attempt + 1))
    done
    return "$rc"
}

# fetch URL TUR VIDEO_SABLONU SES_SABLONU   (URL "@FILE:yol" ise listeden indirir)
fetch() {
    local url="$1" type="$2" vtpl="$3" atpl="$4" rc=0 r2=0
    local src=("$url") va=() aa=()
    case "$url" in @FILE:*) src=(-a "${url#@FILE:}") ;; esac
    [ "$FORMAT" = "AUDIO_ONLY" ] && type=audio
    if [ "$type" = "video" ] || [ "$type" = "both" ]; then
        va=()
        if [ -n "$V_ARCH" ]; then mkdir -p "$(dirname "$V_ARCH")"; va=(--download-archive "$V_ARCH" --ignore-errors); fi
        ytdlp_retry "${LIST_ARGS[@]}" "${va[@]}" -f "$FORMAT" --merge-output-format mp4 -o "$vtpl" "${src[@]}"
        rc=$?
        [ "$rc" -eq 4 ] && return 4
    fi
    if [ "$type" = "audio" ] || [ "$type" = "both" ]; then
        aa=()
        if [ -n "$A_ARCH" ]; then mkdir -p "$(dirname "$A_ARCH")"; aa=(--download-archive "$A_ARCH" --ignore-errors); fi
        build_common
        ytdlp_retry "${LIST_ARGS[@]}" "${aa[@]}" "${AUDIO_ARGS[@]}" -o "$atpl" "${src[@]}"
        r2=$?
        [ "$rc" -eq 0 ] && rc=$r2
    fi
    return "$rc"
}

add_failed() { local line="$2|$1"; grep -qxF "$line" "$FAILED_FILE" 2>/dev/null || echo "$line" >> "$FAILED_FILE"; }

finish_job() {  # finish_job RC URL TUR ETIKET
    local rc="$1" url="$2" type="$3" label="$4"
    [ "$type" != "audio" ] && fix_compat "$JOB_MARK"
    media_scan
    if [ "$rc" -eq 0 ]; then notify "$label tamamlandı ✅"; return 0; fi
    ANY_FAIL=1
    if [ "$rc" -eq 5 ]; then notify "$label: giriş gerekiyor ⚠️"; return "$rc"; fi
    add_failed "$url" "$type"
    notify "$label indirilemedi ❌"
    echo "❌ İndirilemedi. Link 'başarısızlar' listesine eklendi (manuel menüden tekrar denenebilir)."
    return "$rc"
}

# ---------------------------------------------------------------- kalite menusu
quality_menu() {
    echo "  1) 360p"
    echo "  2) 480p"
    echo "  3) 720p"
    echo "  4) 1080p"
    echo "  5) En yüksek kalite (best)"
    echo "  6) Sadece ses (mp3)"
    local dq="${DEFAULT_QUALITY}p"; [ "$DEFAULT_QUALITY" = best ] && dq="en yüksek"
    read -r -p "Seçim (1-6, Enter = $dq): " secim
    case "$secim" in
        1) FORMAT="$(vfmt 360)" ;;
        2) FORMAT="$(vfmt 480)" ;;
        3) FORMAT="$(vfmt 720)" ;;
        4) FORMAT="$(vfmt 1080)" ;;
        5) FORMAT="$(vfmt "")" ;;
        6) FORMAT="AUDIO_ONLY" ;;
        *) FORMAT="$(default_fmt)" ;;
    esac
}

get_format_for_url() {
    local url="$1" duration dur_int
    FORMAT="$(vfmt "")"
    [ "$INTERACTIVE" = 1 ] || return 0
    duration=$(timeout 40 yt-dlp --no-warnings --socket-timeout 15 "${EXTRA_ARGS[@]}" --print duration "$url" 2>/dev/null | tail -1)
    if [[ "$duration" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        dur_int=${duration%.*}
        if [ "$dur_int" -gt 300 ]; then
            echo
            echo "⏱  Video uzunluğu: $((dur_int/60)) dk $((dur_int%60)) sn (5 dakikadan uzun)"
            echo "Hangi kalitede indirmek istersin?"
            quality_menu
        fi
    fi
}

use_cookies() {  # use_cookies ANAHTAR  (tiktok, twitter, youtube, facebook, alan.adi)
    EXTRA_ARGS=()
    local f="$COOKIE_DIR/$1.txt"
    if [ ! -f "$f" ]; then
        case "$1" in
            tiktok)  f="$TIKTOK_COOKIES" ;;
            twitter) f="$COOKIES_FILE" ;;
        esac
    fi
    [ -f "$f" ] && EXTRA_ARGS=(--cookies "$f")
    return 0
}

# ---------------------------------------------------------------- TikTok koleksiyonlari
col_id_from_url() { local u="${1%%\?*}"; u="${u%/}"; echo "${u##*-}"; }
col_name_from_url() {
    local u="${1%%\?*}" n
    u="${u%/}"; n="${u##*/}"; n="${n%-*}"
    python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))' "$n" 2>/dev/null || echo "$n"
}
col_field() {  # col_field ID ALAN_NO
    [ -f "$COL_FILE" ] || return 0
    awk -F'|' -v id="$1" -v f="$2" '$1==id{print $f; exit}' "$COL_FILE"
}
col_remove() { [ -f "$COL_FILE" ] && { grep -v "^$1|" "$COL_FILE" > "$COL_FILE.tmp"; mv "$COL_FILE.tmp" "$COL_FILE"; }; return 0; }
col_save() {  # ID AD URL TUR
    col_remove "$1"
    printf '%s|%s|%s|%s\n' "$1" "$(printf '%s' "$2" | tr '|' '_')" "$3" "$4" >> "$COL_FILE"
}
col_set_type() { awk -F'|' -v OFS='|' -v id="$1" -v t="$2" '$1==id{$4=t}1' "$COL_FILE" > "$COL_FILE.tmp" && mv "$COL_FILE.tmp" "$COL_FILE"; }

# yt-dlp koleksiyonu desteklemezse: TikTok'un kendi web servisinden video listesini cek (yedek yontem)
collection_list_fallback() {  # ID COOKIE_DOSYASI CIKTI_DOSYASI
    python3 - "$1" "$2" "$3" <<'PY'
import sys, json, urllib.request, urllib.parse
cid, cj, out = sys.argv[1:4]
ck = []
try:
    for line in open(cj):
        if line.startswith('#') or not line.strip():
            continue
        p = line.rstrip('\n').split('\t')
        if len(p) >= 7:
            ck.append(p[5] + '=' + p[6])
except Exception:
    pass
hdr = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "Referer": "https://www.tiktok.com/",
    "Cookie": "; ".join(ck),
}
urls, seen, cursor = [], set(), 0
for _ in range(300):
    q = urllib.parse.urlencode({"aid": "1988", "app_name": "tiktok_web", "device_platform": "web_pc",
                                "collectionId": cid, "count": "30", "cursor": str(cursor), "sourceType": "113"})
    try:
        req = urllib.request.Request("https://www.tiktok.com/api/collection/item_list/?" + q, headers=hdr)
        d = json.loads(urllib.request.urlopen(req, timeout=20).read().decode() or "{}")
    except Exception as e:
        print("TikTok servis hatası:", e, file=sys.stderr)
        break
    items = d.get("itemList") or []
    for it in items:
        vid = it.get("id")
        au = (it.get("author") or {}).get("uniqueId") or "_"
        if vid and vid not in seen:
            seen.add(vid)
            urls.append("https://www.tiktok.com/@%s/video/%s" % (au, vid))
    if not d.get("hasMore") or not items:
        break
    nc = d.get("cursor")
    if nc is None or str(nc) == str(cursor):
        break
    cursor = nc
open(out, "w").write("\n".join(urls) + ("\n" if urls else ""))
print(len(urls))
PY
}

job_collection() {  # URL TUR
    local url="$1" type="$2" id name sname adet rc lf n
    id=$(col_id_from_url "$url")
    name=$(col_field "$id" 2)
    [ -z "$name" ] && name=$(col_name_from_url "$url")
    [ -z "$name" ] && name="Koleksiyon"
    sname=$(sanitize "$name")
    [ -z "$sname" ] && sname="Koleksiyon"
    echo ">> TikTok koleksiyonu: $name  [$(type_label "$type")]"
    notify "TikTok koleksiyonu indiriliyor: $name"
    use_cookies tiktok
    [ -f "$TIKTOK_COOKIES" ] || echo "ℹ️  TikTok girişi yok; özel klasörler için manuel menüden giriş yap."
    FORMAT="best/bestvideo+bestaudio"
    LIST_ARGS=()
    if [ "$INTERACTIVE" = 1 ]; then
        read -r -p "Kaç video indirilsin? (hepsi için Enter): " adet
        if [[ "$adet" =~ ^[0-9]+$ ]] && [ "$adet" -gt 0 ]; then LIST_ARGS+=(--playlist-end "$adet"); fi
    fi
    V_ARCH="$DOWNLOAD_DIR/TikTok/Koleksiyonlar/$sname/.indirilenler.txt"
    A_ARCH="$MUSIC_DIR/TikTok/$sname/.indirilenler.txt"
    local vtpl="$DOWNLOAD_DIR/TikTok/Koleksiyonlar/$sname/%(upload_date)s - %(title).60s.%(ext)s"
    local atpl="$MUSIC_DIR/TikTok/$sname/%(title).80s.%(ext)s"
    fetch "$url" "$type" "$vtpl" "$atpl"; rc=$?
    if [ "$rc" -eq 4 ]; then
        echo "ℹ️  yt-dlp bu koleksiyon linkini tanımadı, TikTok servisinden liste çekiliyor..."
        lf="$HOME/.termux-downloader-list.txt"
        n=$(collection_list_fallback "$id" "$TIKTOK_COOKIES" "$lf" 2>&1 | tail -1)
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ]; then
            echo "📃 $n video bulundu."
            fetch "@FILE:$lf" "$type" "$vtpl" "$atpl"; rc=$?
        else
            echo "❌ Koleksiyon listesi alınamadı. TikTok girişini (sessionid) yenile ve tekrar dene."
            rc=5
        fi
    fi
    V_ARCH=""; A_ARCH=""
    finish_job "$rc" "$url" "$type" "Koleksiyon"
}

