            5) choose_type 1; cfg_set MANUAL_TYPE "$CHOSEN_TYPE" ;;
            6) read -r -p "Sanatçı adı: " v; v=$(printf '%s' "$v" | tr -d '%:'); [ -n "$v" ] && cfg_set ARTIST "$v" ;;
            7) if [ "$AUTO_YTDLP_UPDATE" = 1 ]; then cfg_set AUTO_YTDLP_UPDATE 0; else cfg_set AUTO_YTDLP_UPDATE 1; fi ;;
            8) echo "  1) 360p   2) 480p   3) 720p   4) 1080p   5) En yüksek"
