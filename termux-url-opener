# ---------------------------------------------------------------- yardimcilar
notify() { command -v termux-notification >/dev/null 2>&1 && (timeout 2 termux-notification --title "Termux İndirici - Samiullah Dilsuz" --content "$1" >/dev/null 2>&1 &) ; true; }

cfg_set() {  # cfg_set ANAHTAR DEGER  (dosyaya yazar ve hemen uygular)
    local k="$1" v="$2"
    touch "$CONF"
    grep -v "^$k=" "$CONF" > "$CONF.tmp" 2>/dev/null
    printf '%s=%q\n' "$k" "$v" >> "$CONF.tmp"
    mv "$CONF.tmp" "$CONF"
    printf -v "$k" '%s' "$v"
    MUSIC_DIR="$DOWNLOAD_DIR/Muzik"
}

sanitize() { printf '%s' "$1" | tr '/\\:*?"<>|\n' '_________' | sed 's/^[ .]*//; s/[ .]*$//'; }

type_label() {
    case "$1" in
        video) echo "Video" ;;
        audio) echo "Müzik (mp3)" ;;
        both)  echo "Video + mp3" ;;
        *)     echo "Her seferinde sor" ;;
    esac
}

choose_type() {  # $1=1 ise "her seferinde sor" secenegi de gosterilir -> CHOSEN_TYPE
    echo "Nasıl indirilsin?"
    echo "  1) Video (mp4)"
    echo "  2) Müzik (mp3)"
    echo "  3) İkisi birden (video + mp3)"
    [ "$1" = 1 ] && echo "  4) Her seferinde sor"
    read -r -p "Seçim: " _s
    case "$_s" in
        2) CHOSEN_TYPE=audio ;;
        3) CHOSEN_TYPE=both ;;
        4) if [ "$1" = 1 ]; then CHOSEN_TYPE=ask; else CHOSEN_TYPE=video; fi ;;
        *) CHOSEN_TYPE=video ;;
    esac
}

pause() { read -r -p "Devam etmek için Enter'a bas..." _; }

# ---------------------------------------------------------------- ag kontrolu
has_internet() {
    curl -s -o /dev/null --max-time 5 https://www.gstatic.com/generate_204 2>/dev/null \
    || curl -s -o /dev/null --max-time 5 https://1.1.1.1 2>/dev/null \
    || curl -s -o /dev/null --max-time 5 https://github.com 2>/dev/null
}

wait_for_internet() {  # $1 = en fazla kac saniye beklensin (varsayilan 300)
    has_internet && return 0
    local max="${1:-300}" i=0
    echo "🌐 İnternet yok, bağlantı bekleniyor (en fazla $((max/60)) dk). İndirme gelince kaldığı yerden devam eder..."
    while [ "$((i*5))" -lt "$max" ]; do
        sleep 5
        if has_internet; then echo "✅ Bağlantı geldi."; return 0; fi
        i=$((i+1))
    done
    echo "⚠️ Bağlantı gelmedi, yine de deneniyor..."
    return 0
}

wifi_connected() {
    command -v termux-wifi-connectioninfo >/dev/null 2>&1 || return 0
    local o
    o=$(timeout 6 termux-wifi-connectioninfo 2>/dev/null) || return 0
    [ -z "$o" ] && return 0
    echo "$o" | grep -q '"supplicant_state": *"COMPLETED"'
}

wifi_gate() {
    [ "$WIFI_ONLY" = 1 ] || return 0
    wifi_connected && return 0
    echo "📶 Wi-Fi bağlı değil (\"Sadece Wi-Fi\" ayarı açık). 2 dk bekleniyor..."
    local i=0
    while [ "$i" -lt 12 ]; do
        sleep 10
        wifi_connected && return 0
        i=$((i+1))
    done
    read -r -p "1) Mobil veriyle indir  2) Vazgeç [2]: " _w
    [ "$_w" = 1 ] && return 0
    return 1
}

