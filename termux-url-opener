col_actions() {  # "id|ad|url|tur"
    local id name url ctype
    IFS='|' read -r id name url ctype <<< "$1"
    while true; do
        echo
        echo "── $name  [$(type_label "$ctype")] ──"
        echo "  1) İndir"
        echo "  2) Türü değiştir (hatırlanır)"
        echo "  3) Listeden sil"
        echo "  0) Geri"
        read -r -p "Seçim: " s
        case "$s" in
            1)
                local t="$ctype"
                if [ "$t" = "ask" ]; then
                    choose_type 0; t="$CHOSEN_TYPE"
                    read -r -p "Bu klasör için hep böyle olsun mu? (e/H): " k
                    case "$k" in e|E|evet) col_set_type "$id" "$t"; ctype="$t" ;; esac
                fi
                INTERACTIVE=1
                process_url "$url" "$t"
                echo; pause ;;
            2)
